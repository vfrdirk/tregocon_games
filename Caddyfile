# Sandbox: serve on LAN IP:8080, no TLS (internal only).
# Phase 1 (Lightsail): replace with play.tregocon.games + TLS.
{
    admin off
    auto_https off
}

:8080 {
    @api path /api/*
    @swagger path /docs /docs/* /openapi.json
    reverse_proxy @api 127.0.0.1:8000
    reverse_proxy @swagger 127.0.0.1:8000
    # Frontend SPA (host networking, nginx on 8081) — default
    reverse_proxy 127.0.0.1:8081
}
