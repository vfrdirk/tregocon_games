# Copy to .env and fill in. Used by docker-compose.prod.yml on the Lightsail host.
# ---- Postgres ----
POSTGRES_USER=tregocon
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=tregocon

# ---- Public URL (used in notification emails) ----
PUBLIC_URL=https://play.tregocon.games

# ---- ACME / Let's Encrypt contact email ----
ACME_EMAIL=you@example.com

# ---- Comms (optional; leave blank to run disabled-safe in sandbox mode) ----
# AWS SES
SES_REGION=
SES_FROM_EMAIL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
